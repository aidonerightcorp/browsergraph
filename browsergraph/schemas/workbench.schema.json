{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aidonerightcorp/browsergraph/schemas/workbench.schema.json",
  "title": "WorkbenchDefinition",
  "description": "Ordered task stages, the complete set of atomic candidates admitted to each, complete routes through them, and the typed control plane that improves them. Stages are the only thing that is a column; configuration dimensions expand candidates inside a stage.",
  "type": "object",
  "required": ["schema_version", "stages"],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0"},
    "title": {"type": "string"},
    "task": {"type": "string"},
    "success": {"type": "string", "description": "The task-level oracle, independent of any producer."},
    "nodes": {"type": "array", "items": {"$ref": "node-manifest.schema.json"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}},
    "planes": {"type": "array", "items": {"$ref": "#/$defs/stage"},
      "description": "Version-1 alias for stages, still loadable. New output uses 'stages', which does not collide with configuration planes."},
    "solutions": {"type": "array", "items": {"$ref": "#/$defs/solution"}},
    "feedback_channels": {"type": "array", "items": {"$ref": "#/$defs/feedback"}},
    "optimization_profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "candidate": {
      "type": "object", "required": ["id", "node_id"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "description": "Stable and parameter-sensitive: changing a value changes the id, changing key order does not."},
        "node_id": {"type": "string"},
        "name": {"type": "string"},
        "params": {"type": "object"},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "stage": {
      "type": "object", "required": ["id"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "input_type": {"type": "string"},
        "output_type": {"type": "string"},
        "success": {"type": "string"},
        "optional": {"type": "boolean", "default": false,
          "description": "Only an optional stage may admit a pass-through candidate."},
        "variant_axes": {"type": "array", "items": {"type": "string"},
          "description": "Dimensions worth exploring inside the stage. These never become columns."},
        "required_capabilities": {"type": "array", "items": {"type": "string"}},
        "candidates": {"type": "array", "items": {"type": "string"},
          "description": "Every compatible candidate the registry knows, not a chosen few."}
      }
    },
    "solution": {
      "type": "object", "required": ["id", "route"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "status": {"enum": ["baseline", "candidate", "learned", "rejected", "retired"]},
        "route": {"type": "object", "additionalProperties": {"type": "string"},
          "description": "Exactly one primary candidate per stage."},
        "fallbacks": {"type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}},
          "description": "Belong to a stage's choice. They never become extra stages."},
        "metrics": {"type": "object", "additionalProperties": {"type": "number"}},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "feedback": {
      "type": "object", "required": ["id", "signal", "scope", "action"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "signal": {"type": "string"},
        "scope": {"enum": ["candidate","edge","stage","route","task","registry","version","context"]},
        "producer": {"type": "string"},
        "consumer": {"type": "string"},
        "action": {"type": "string"},
        "description": {"type": "string"},
        "required": {"type": "boolean"}
      }
    },
    "profile": {
      "type": "object", "required": ["id", "objectives"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "strategy": {"type": "string"},
        "objectives": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["metric", "direction"],
          "additionalProperties": false,
          "properties": {
            "metric": {"type": "string"},
            "direction": {"enum": ["maximize", "minimize"]},
            "weight": {"type": "number", "exclusiveMinimum": 0}
          }}},
        "minimum_evidence": {"type": "integer", "minimum": 0},
        "exploration": {"type": "number", "minimum": 0, "maximum": 1},
        "description": {"type": "string"}
      }
    }
  }
}
